# ==========================================
# AI-Based Mock Interview Preparation System
# Project ID: GIMS-BSSE-F202206
# Environment Configuration
# ==========================================

# Application Settings
PROJECT_NAME="AI-Based Mock Interview Preparation System"
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=gims-bsse-f202206-super-secret-key-change-in-production-min32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL or SQLite for non-docker local dev)
# For Docker / Local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_mock_interview
# Fallback SQLite example (if no PostgreSQL installed locally):
# DATABASE_URL=sqlite:///./mock_interview.db

# Seed Admin User
FIRST_ADMIN_EMAIL=admin@gims.edu.pk
FIRST_ADMIN_PASSWORD=AdminSecurePassword123!
FIRST_ADMIN_NAME="System Administrator"

# AI Services & API Keys
# Gemini API Key (Primary LLM Provider)
GEMINI_API_KEY=
# Optional OpenAI Key (Alternative Provider)
OPENAI_API_KEY=
# Whisper Model Size (tiny, base, small, medium, large-v3)
WHISPER_MODEL_SIZE=base
# LanguageTool API Endpoint (Public cloud or self-hosted container)
LANGUAGETOOL_URL=https://api.languagetoolplus.com/v2
# Optional YouTube Data API v3 Key
YOUTUBE_API_KEY=

# File Storage Configuration
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=100

# Email / SMTP Configuration (for OTP verification and report emailing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@gims.edu.pk
EMAILS_FROM_NAME="GIMS AI Mock Interview"
SMTP_TLS=True
SMTP_SSL=False

# Google OAuth (Optional for Google Sign-In)
GOOGLE_CLIENT_ID=

# CORS Allowed Origins (Comma separated or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
